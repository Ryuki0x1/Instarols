{
  "manifest_version": 3,
  "name": "Instarols",
  "version": "0.1.0",
  "description": "YouTube-style controls for Instagram Reels: timeline scrubbing, volume, playback speed, and play/pause.",
  "icons": {
    "16": "content/icon-16.png",
    "32": "content/icon-32.png",
    "48": "content/icon-48.png",
    "128": "content/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": [
        "content/video-tracker.js",
        "content/ui.js",
        "content/control-playpause.js",
        "content/control-volume.js",
        "content/control-speed.js",
        "content/control-scrubber.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
